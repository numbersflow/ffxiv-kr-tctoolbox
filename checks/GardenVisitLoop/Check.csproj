<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><NoWarn>$(NoWarn);0436</NoWarn></PropertyGroup>
  <PropertyGroup><VisitSourceDirectory Condition="'$(VisitSourceDirectory)'==''">$(MSBuildProjectDirectory)/../../Harvest/Planning</VisitSourceDirectory></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../Harvest/Harvest.csproj" /><Compile Include="$(IntermediateOutputPath)Visit.g.cs" /></ItemGroup>
  <Target Name="ExtractActualVisit" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/extract.py&quot; &quot;$(VisitSourceDirectory)&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Visit.g.cs&quot;" />
  </Target>
</Project>
